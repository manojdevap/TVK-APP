# Neon Postgres connection string (Neon dashboard -> Connection Details -> pooled)
# Looks like: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Signs the session cookie. REQUIRED in production — at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
